# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Paris

# Production derriere Traefik/Coolify (TLS termine par le proxy)
# EVKHA_BEHIND_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://evkha.fr,https://www.evkha.fr
EVKHA_BEHIND_PROXY=false
CSRF_TRUSTED_ORIGINS=

# URL publique du serveur (URLs absolues des PDFs pour Brevo et les clients)
# Production : https://evkha.fr
EVKHA_BASE_URL=http://localhost:8000

DATABASE_URL=postgres://evkha:evkha@postgres:5432/evkha
POSTGRES_DB=evkha
POSTGRES_USER=evkha
POSTGRES_PASSWORD=change-me

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# External APIs - never commit real values
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GAMMA_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@evkha.fr
BREVO_SENDER_NAME=Evkha
SYSTEME_WEBHOOK_SECRET=
TALLY_WEBHOOK_SECRET=

# Generation - modele Claude actif (tarification Cost Engine)
EVKHA_CLAUDE_MODEL=claude-sonnet
# Identifiant API Anthropic reel (laisser vide pour utiliser l'alias ci-dessus)
EVKHA_ANTHROPIC_MODEL_ID=
# Adaptateurs externes : true = stubs deterministes (dev/CI), false = appels reels
# Production : EVKHA_USE_STUB_AI/EMAIL/PDF=false.
# EVKHA_USE_STUB_GAMMA reste true : client Gamma reel non cable
# (non bloquant — toutes les offres ont gamma_enabled=false).
EVKHA_USE_STUB_AI=true
EVKHA_USE_STUB_DOCS=true
EVKHA_USE_STUB_GAMMA=true
EVKHA_USE_STUB_EMAIL=true
EVKHA_USE_STUB_PDF=true

# Dashboard auth (Phase 6)
# Dev/CI : EVKHA_DASHBOARD_AUTH_DISABLED=true (defaut)
# Production : EVKHA_DASHBOARD_AUTH_DISABLED=false + token fort
# Generer le token : openssl rand -hex 32
EVKHA_DASHBOARD_AUTH_DISABLED=true
EVKHA_DASHBOARD_TOKEN=

# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_POSTGRES_DB=n8n

# Product decisions frozen in docs/master-plan.html section 11
EVKHA_DEFAULT_RETENTION_DAYS=7
EVKHA_EMAIL_PROVIDER=brevo
