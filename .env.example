# Django
DJANGO_SECRET_KEY=change-me
# `true`, et ce n'est pas un detail de confort. Hors DEBUG, les controles
# systeme refusent la configuration de developpement decrite plus bas :
# EVKHA_USE_STUB_AI et EVKHA_USE_STUB_SEARCH a `true` levent deux erreurs
# evkha.C005, et EVKHA_APP_URL vide une erreur evkha.C004. Une erreur de
# controle arrete `migrate`, donc la chaine de demarrage entiere.
# Ce fichier portait `false` : le copier tel quel donnait un conteneur qui ne
# demarrait jamais, sans cause lisible.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Paris

# Production derriere Traefik/Coolify (TLS termine par le proxy)
# EVKHA_BEHIND_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://evkha.fr,https://www.evkha.fr
EVKHA_BEHIND_PROXY=false
CSRF_TRUSTED_ORIGINS=

# URL publique du serveur (URLs absolues des PDFs pour Brevo et les clients)
# Production : https://evkha.fr
EVKHA_BASE_URL=http://localhost:8000

# Adresse de l'ESPACE CLIENT, et non de l'API : c'est sur elle que sont batis
# les liens d'invitation et de reinitialisation de mot de passe. Construits sur
# EVKHA_BASE_URL, ils renvoyaient un 404 — la fonctionnalite Equipe etait
# livree, testee, et inutilisable. Vide hors DEBUG = erreur evkha.C004.
EVKHA_APP_URL=http://localhost:5173

DATABASE_URL=postgres://evkha:evkha@postgres:5432/evkha
POSTGRES_DB=evkha
POSTGRES_USER=evkha
POSTGRES_PASSWORD=change-me

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# External APIs - never commit real values
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GAMMA_API_KEY=
BREVO_API_KEY=
# Le fournisseur par defaut du code est `resend`, pas `brevo` (voir plus bas) :
# sans cette cle, l'envoi echoue avec une erreur evkha.E002.
RESEND_API_KEY=
BREVO_SENDER_EMAIL=contact@evkha.fr
BREVO_SENDER_NAME=Evkha
SYSTEME_WEBHOOK_SECRET=
TALLY_WEBHOOK_SECRET=
# Paiement. Sans le secret de signature, les evenements Stripe sont TOUS
# rejetes : un client peut payer sans jamais recevoir ses credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Generation - modele Claude actif (tarification Cost Engine)
EVKHA_CLAUDE_MODEL=claude-sonnet
# Identifiant API Anthropic reel (laisser vide pour utiliser l'alias ci-dessus)
EVKHA_ANTHROPIC_MODEL_ID=
# Adaptateurs externes : true = stubs deterministes (dev/CI), false = appels reels
# Production : EVKHA_USE_STUB_AI/SEARCH/EMAIL/PDF=false.
# EVKHA_USE_STUB_GAMMA reste true : client Gamma reel non cable
# (non bloquant — toutes les offres ont gamma_enabled=false).
#
# DEUX de ces drapeaux sont INTERDITS en production, et refuses par un controle
# systeme : EVKHA_USE_STUB_AI et EVKHA_USE_STUB_SEARCH. Ils ne coupent pas un
# detail, ils remplacent la SUBSTANCE du livrable — le client recoit un
# document qui a la forme d'une etude sans en etre une. La liste qui fait foi
# est BOUCHONS_INTERDITS_EN_PRODUCTION, dans organisations/checks.py.
EVKHA_USE_STUB_AI=true
# Etait ABSENT de ce fichier, donc a `true` par defaut sans que personne ne le
# choisisse. Chaque etude etait alors redigee sur des resultats de recherche
# portant « Contenu de demonstration ». Le fournisseur reel est GRATUIT et ne
# demande aucune cle : la recherche n'etait pas coupee pour economiser.
EVKHA_USE_STUB_SEARCH=true
EVKHA_USE_STUB_DOCS=true
EVKHA_USE_STUB_GAMMA=true
EVKHA_USE_STUB_EMAIL=true
EVKHA_USE_STUB_PDF=true

# Dashboard auth (Phase 6)
# Dev/CI : EVKHA_DASHBOARD_AUTH_DISABLED=true (defaut)
# Production : EVKHA_DASHBOARD_AUTH_DISABLED=false + token fort
# Generer le token : openssl rand -hex 32
EVKHA_DASHBOARD_AUTH_DISABLED=true
EVKHA_DASHBOARD_TOKEN=

# n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_POSTGRES_DB=n8n

# Product decisions frozen in docs/master-plan.html section 11
EVKHA_DEFAULT_RETENTION_DAYS=7
# `resend` est le defaut du code (settings.py) ET ce qui tourne en production
# depuis l'incident de messagerie du 07/08/2026. Ce fichier disait `brevo` :
# trois sources, deux reponses (regle 5).
EVKHA_EMAIL_PROVIDER=resend
