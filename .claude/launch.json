{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "evkha-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "evkha-django",
      "runtimeExecutable": "python",
      "runtimeArgs": ["manage.py", "runserver", "8000"],
      "port": 8000,
      "env": { "PYTHONPATH": "backend" }
    }
  ]
}
